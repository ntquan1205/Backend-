{
  "base_url": "http://localhost:8000",
  "resource": "sessions",
  "id_field": "id",
  "missing_id": "999999",
  "list_key": null,
  "text_field": "movie",
  "search": { "param": "q", "field": "movie" },
  "create": {
    "movie": "Интерстеллар",
    "hall": "Зал 1",
    "date_time": "2026-06-01T18:00:00Z",
