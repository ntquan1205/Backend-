  },
  "rule": {
    "description": "Одно место на сеанс нельзя продать дважды",
    "parent": { "seats": 2 },
    "setup": [
      { "method": "POST", "path": "/api/sessions/{id}/tickets", "body": { "seat_number": 1, "customer": "Нгуен" } }
    ],
    "violate": { "method": "POST", "path": "/api/sessions/{id}/tickets", "body": { "seat_number": 1, "customer": "Петров" } },
    "expect_status": 409
  },
  "stats_path": "/api/sessions/stats"
